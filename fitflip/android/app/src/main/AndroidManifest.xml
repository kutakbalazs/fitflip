<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links. Without this, every link we mail someone — email
                 confirmation, password reset, unsubscribe — opened the
                 browser instead of the app, stranding them mid-signup in a
                 web session the app knows nothing about. iOS had its half of
                 this (apple-app-site-association) from the start; Android's
                 was never added.

                 autoVerify makes Android fetch
                 https://www.fitflip.app/.well-known/assetlinks.json and check
                 our signing certificate before it will open links silently.
                 If that file or the fingerprint is wrong, the system falls
                 back to the browser with no error anywhere. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Scoped to the same paths iOS claims in its
                     apple-app-site-association. Claiming the whole domain
                     would hijack every marketing and legal page into the app,
                     including the privacy-policy URL Google Play crawls. -->
                <data android:scheme="https" android:host="www.fitflip.app" android:pathPrefix="/auth/confirm" />
                <data android:scheme="https" android:host="fitflip.app" android:pathPrefix="/auth/confirm" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Home-screen widget: one tap opens the camera. -->
        <receiver
            android:name=".ScanWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scan_widget_info" />
        </receiver>

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera for taking photos of items to identify (web file input capture). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Android 13+ requires an explicit runtime grant before any notification
         can be posted. Without this line the permission request silently
         resolves as denied and watcher notifications never appear. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
