<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 0 on purpose. The value shown comes from what the app
  last wrote, so a system-scheduled refresh would redraw the same number and
  cost battery for nothing; the app pushes an update when it has one.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/scan_widget"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
