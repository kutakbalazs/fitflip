<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the launch splash (#0A0C11 ground, #1D1F25 tile) so the widget
     reads as part of the same app rather than a generic card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0A0C11" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#1D1F25" />
</shape>
